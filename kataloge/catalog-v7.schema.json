{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/geoObserver/geobasis_loader/schemas/catalog-v7.schema.json",
  "title": "GeoBasis Loader catalog format v7",
  "description": "Validates v7 catalog indexes and individual catalogs.",
  "oneOf": [
    {
      "$ref": "#/$defs/catalogIndex"
    },
    {
      "$ref": "#/$defs/catalog"
    }
  ],
  "$defs": {
    "formatVersion": {
      "type": "number",
      "const": 7.0
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "catalogIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "catalog_source",
        "catalogs",
        "modified"
      ],
      "properties": {
        "format_version": {
          "$ref": "#/$defs/formatVersion"
        },
        "catalog_source": {
          "type": "string",
          "enum": [
            "server",
            "local"
          ]
        },
        "catalogs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogIndexEntry"
          }
        },
        "modified": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "catalogIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "file"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\/]+\\.json$"
        },
        "author": {
          "type": "string",
          "$comment": "This property is non-canonical. The author of the actual catalog is correct. This property is just for convenience/usability."
        },
        "description": {
          "type": "string",
          "$comment": "This property is non-canonical. The description of the actual catalog is correct. This property is just for convenience/usability."
        },
        "modified": {
          "$ref": "#/$defs/dateTime",
          "$comment": "This property is non-canonical. The modified datetime of the actual catalog is correct. This property is just for convenience/usability."
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "id",
        "modified",
        "author",
        "description",
        "legal_notice",
        "global_crs",
        "regions"
      ],
      "properties": {
        "format_version": {
          "$ref": "#/$defs/formatVersion"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "catalog_version": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.01
        },
        "modified": {
          "$ref": "#/$defs/dateTime"
        },
        "author": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "legal_notice": {
          "type": "string",
          "const": "This catalog is provided “as is” without warranty of any kind. The catalog author does not guarantee the accuracy, completeness, currency, legality, or availability of the catalog or the referenced services, and assumes no responsibility for their content, operation, or continued availability. The catalog author is not liable for any direct or indirect loss or damage arising from the use of, or reliance on, this catalog or the referenced services, except where liability cannot legally be excluded. The referenced services are provided by independent third parties; their terms of use, licenses, fees, access restrictions, attribution requirements, and privacy policies apply. Inclusion of a service does not constitute an endorsement or guarantee of its suitability."
        },
        "global_crs": {
          "$ref": "#/$defs/crsList"
        },
        "service_templates": {
          "$ref": "#/$defs/serviceTemplates"
        },
        "regions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/region"
          }
        }
      }
    },
    "serviceTemplates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_uris",
        "uri_patterns"
      ],
      "properties": {
        "server_uris": {
          "type":  "object",
          "minProperties": 0,
          "additionalProperties": {
            "$ref": "#/$defs/uri"
          }
        },
        "uri_patterns": {
          "type": "object",
          "minProperties": 0,
          "additionalProperties": {
            "$ref": "#/$defs/uriPattern"
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "topics"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "separator_after": {
          "type": "boolean"
        },
        "topics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/topic"
        },
        {
          "$ref": "#/$defs/group"
        },
        {
          "$ref": "#/$defs/combination"
        }
      ]
    },
    "entryThirdPartyData": {
      "type": "object",
      "properties": {
        "gbl_view": {
          "type": "boolean"
        },
        "osm_usable": {
          "type": "boolean"
        },
        "komgis_layerid": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "komgis_node": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "komgis_priority": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "entryMetadata": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "modified": {
          "$ref": "#/$defs/dateTime"
        },
        "deprecated": {
          "type": "boolean"
        },
        "deprecated_message": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "separator_after": {
          "type": "boolean"
        }
      }
    },
    "topic": {
      "allOf": [
        {
          "$ref": "#/$defs/entryMetadata"
        },
        {
          "$ref": "#/$defs/entryThirdPartyData"
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "entry_type",
            "title",
            "service_type"
          ],
          "dependentRequired": {
            "server_uri": [
              "uri_pattern",
              "layer_id"
            ]
          },
          "properties": {
            "entry_type": {
              "const": "topic"
            },
            "service_type": {
              "type": "string",
              "enum": [
                "ogc_wms",
                "ogc_wfs",
                "ogc_wcs",
                "ogc_api_features",
                "ogc_vectortiles",
                "ogc_wmts",
                "arcgis_featureserver",
                "arcgis_mapserver",
                "web"
              ]
            },
            "crs": {
              "$ref": "#/$defs/crsList"
            },
            "service_uri": {
              "$comment": "This property can be used to directly specify the URI of the service. If this property is used, server_uri, uri_pattern, and layer_id will be ignored (since it's the entire URI). Template {crs} must still be included if it's not a web topic.",
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri-template",
                  "minLength": 1
                }
              ]
            },
            "server_uri": {
              "$comment": "This property can be used to specify the server URI of the service. It can be a server URI or a key from the global server_uris (identified by www./http). If this property is used, uri_pattern and layer_id must also be specified.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:https?://|www\\.)"
                },
                {
                  "$ref": "#/$defs/nonEmptyString"
                }
              ]
            },
            "uri_pattern": {
              "$comment": "This property can be used to specify the URI pattern of the service. It can be a URI pattern or a key from the global uri_patterns (identified by the {crs} placeholder). The property server_uri must be used to specify the server URI of this service.",
              "anyOf":[
                {
                  "$ref": "#/$defs/uriPattern"
                },
                {
                  "$ref": "#/$defs/nonEmptyString"
                }
              ]
            },
            "layer_id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1
            },
            "min_scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fill_color": {
              "$ref": "#/$defs/color",
              "default": [220, 220, 220]
            },
            "stroke_color": {
              "$ref": "#/$defs/color",
              "default": "black"
            },
            "stroke_width": {
              "type": "number",
              "minimum": 0,
              "default": 0.3
            }
          },
          "oneOf": [
            {
              "required": [
                "service_uri"
              ],
              "not": {
                "anyOf": [
                  { "required": ["server_uri"] },
                  { "required": ["uri_pattern"] },
                  { "required": ["layer_id"] }
                ]
              }
            },
            {
              "required": [
                "server_uri",
                "uri_pattern",
                "layer_id"
              ],
              "not": {
                "required": [
                  "service_uri"
                ]
              }
            }
          ],
          "if": {
            "required": [
              "service_type"
            ],
            "properties": {
              "service_type": {
                "const": "web"
              }
            }
          },
          "then": {
            "required": [
              "service_uri"
            ],
            "not": {
              "anyOf":[
                { "required": ["crs"] },
                { "required": ["server_uri"] },
                { "required": ["uri_pattern"] },
                { "required": ["layer_id"] }
              ]
            }
          },
          "else": {
            "if": {
              "required": ["service_uri"]
            },
            "then": {
              "properties": {
                "service_uri": {
                  "type": "string",
                  "pattern": "^(?=.*\\{crs\\}).*$"
                }
              }
            }
          }
        }
      ]
    },
    "group": {
      "allOf": [
        {
          "$ref": "#/$defs/entryMetadata"
        },
        {
          "$ref": "#/$defs/entryThirdPartyData"
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "entry_type",
            "title",
            "crs",
            "subtopics"
          ],
          "properties": {
            "entry_type": {
              "const": "group"
            },
            "crs": {
              "$ref": "#/$defs/crsList"
            },
            "subtopics": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/topic"
              }
            }
          }
        }
      ]
    },
    "combination": {
      "allOf": [
        {
          "$ref": "#/$defs/entryMetadata"
        },
        {
          "$ref": "#/$defs/entryThirdPartyData"
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "entry_type",
            "title",
            "crs",
            "references"
          ],
          "properties": {
            "entry_type": {
              "const": "combination"
            },
            "crs": {
              "$ref": "#/$defs/crsList"
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "$comment": "Every reference is an ID for a topic in the same catalog"
              }
            }
          }
        }
      ]
    },
    "crsList": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "color": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      ]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "uriPattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\{crs\\})(?=.*\\{layer_id\\}).*$"
    }
  }
}