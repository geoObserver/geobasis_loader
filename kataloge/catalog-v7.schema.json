{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/geoObserver/geobasis_loader/schemas/catalog-v7.schema.json",
  "title": "GeoBasis Loader catalog format v7",
  "description": "Validates v7 catalog indexes and individual catalogs.",
  "oneOf": [
    {
      "$ref": "#/$defs/catalogIndex"
    },
    {
      "$ref": "#/$defs/catalog"
    }
  ],
  "$defs": {
    "formatVersion": {
      "type": "number",
      "const": 7.0
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "catalogIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "catalog_source",
        "catalogs",
        "modified"
      ],
      "properties": {
        "format_version": {
          "$ref": "#/$defs/formatVersion"
        },
        "catalog_source": {
          "type": "string",
          "enum": [
            "server",
            "local"
          ]
        },
        "catalogs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogIndexEntry"
          }
        },
        "modified": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "catalogIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "file"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\/]+\\.json$"
        },
        "author": {
          "type": "string",
          "$comment": "This property is non-canonical. The author of the actual catalog is correct. This property is just for convenience/useability."
        },
        "description": {
          "type": "string",
          "$comment": "This property is non-canonical. The description of the actual catalog is correct. This property is just for convenience/useability."
        },
        "modified": {
          "$ref": "#/$defs/dateTime",
          "$comment": "This property is non-canonical. The modified datetime of the actual catalog is correct. This property is just for convenience/useability."
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "id",
        "modified",
        "author",
        "description",
        "legal_notice",
        "regions"
      ],
      "properties": {
        "format_version": {
          "$ref": "#/$defs/formatVersion"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "catalog_version": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.01
        },
        "modified": {
          "$ref": "#/$defs/dateTime"
        },
        "author": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "legal_notice": {
          "type": "string",
          "const": "This catalog is provided “as is” without warranty of any kind. The catalog author does not guarantee the accuracy, completeness, currency, legality, or availability of the catalog or the referenced services, and assumes no responsibility for their content, operation, or continued availability. The catalog author is not liable for any direct or indirect loss or damage arising from the use of, or reliance on, this catalog or the referenced services, except where liability cannot legally be excluded. The referenced services are provided by independent third parties; their terms of use, licenses, fees, access restrictions, attribution requirements, and privacy policies apply. Inclusion of a service does not constitute an endorsement or guarantee of its suitability."
        },
        "global_crs": {
          "$ref": "#/$defs/crsList"
        },
        "service_templates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/serviceTemplate"
          }
        },
        "regions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/region"
          }
        }
      }
    },
    "serviceTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "uri_pattern"
      ],
      "properties": {
        "base_url": {
          "$ref": "#/$defs/uri"
        },
        "uri_pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "topics"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "separator_after": {
          "type": "boolean"
        },
        "topics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/topic"
        },
        {
          "$ref": "#/$defs/group"
        },
        {
          "$ref": "#/$defs/combination"
        }
      ]
    },
    "entryThirdPartyData": {
      "type": "object",
      "properties": {
        "gbl_view": {
          "type": "boolean"
        },
        "osm_usable": {
          "type": "boolean"
        },
        "komgis_layerid": {
          "tpye": "string"
        },
        "komgis_node": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "komgis_priority": {
          "type": "string"
        }
      }
    },
    "entryMetadata": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "license_url": {
          "$ref": "#/$defs/uri"
        },
        "modified": {
          "$ref": "#/$defs/dateTime"
        },
        "deprecated": {
          "type": "boolean"
        },
        "deprecated_message": {
          "type": "string"
        },
        "access_constraints": {
          "type": "string"
        },
        "fees": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "separator_after": {
          "type": "boolean"
        }
      }
    },
    "topic": {
      "allOf": [
        {
          "$ref": "#/$defs/entryMetadata"
        },
        {
          "$ref": "#/$defs/entryThirdPartyData"
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "entry_type",
            "title",
            "service_type"
          ],
          "properties": {
            "entry_type": {
              "const": "topic"
            },
            "service_type": {
              "type": "string",
              "enum": [
                "ogc_wms",
                "ogc_wfs",
                "ogc_wcs",
                "ogc_api_features",
                "ogc_vectortiles",
                "ogc_wmts",
                "arcgis_featureserver",
                "arcgis_mapserver",
                "web"
              ]
            },
            "crs": {
              "$ref": "#/$defs/crsList"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "service_template": {
              "$ref": "#/$defs/identifier"
            },
            "layer_id": {
              "type": "string",
              "minLength": 1
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "min_scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fill_color": {
              "$ref": "#/$defs/color"
            },
            "stroke_color": {
              "$ref": "#/$defs/color"
            },
            "stroke_width": {
              "type": "number",
              "minimum": 0
            }
          },
          "oneOf": [
            {
              "required": [
                "uri"
              ],
              "not": {
                "required": [
                  "service_template"
                ]
              }
            },
            {
              "required": [
                "service_template",
                "layer_id"
              ],
              "not": {
                "required": [
                  "uri"
                ]
              }
            }
          ],
          "if": {
            "required": [
              "service_type"
            ],
            "properties": {
              "service_type": {
                "const": "web"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "crs"
              ]
            }
          }
        }
      ]
    },
    "group": {
      "allOf": [
        {
          "$ref": "#/$defs/entryMetadata"
        },
        {
          "$ref": "#/$defs/entryThirdPartyData"
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "entry_type",
            "title",
            "subtopics"
          ],
          "properties": {
            "entry_type": {
              "const": "group"
            },
            "subtopics": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/topic"
              }
            }
          }
        }
      ]
    },
    "combination": {
      "allOf": [
        {
          "$ref": "#/$defs/entryMetadata"
        },
        {
          "$ref": "#/$defs/entryThirdPartyData"
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "entry_type",
            "title",
            "references"
          ],
          "properties": {
            "entry_type": {
              "const": "combination"
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "$comment": "Every reference is a id for a topic in the same catalog"
              }
            }
          }
        }
      ]
    },
    "crsList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "color": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      ]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "format": "uri"
    }
  }
}